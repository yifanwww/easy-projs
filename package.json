{
  "name": "easy-projs",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "homepage": "https://github.com/yifanwww/easy-projs#readme",
  "license": "MIT",
  "author": "yifanwww <yifanw1101@gmail.com> (https://github.com/yifanwww)",
  "bugs": {
    "url": "https://github.com/yifanwww/easy-projs/issues"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yifanwww/easy-projs.git"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "scripts": {
    "build": "pnpm run --recursive --stream build",
    "build-configs": "pnpm run --filter @easy-config/* --stream build",
    "build-libs": "pnpm run --filter @easy-lib/* --stream build",
    "clean": "pnpm run --recursive --no-sort clean",
    "format": "prettier --write \"**/*.{cjs,cts,css,html,js,json,jsx,md,mjs,mts,ts,tsx,yaml,yml}\"",
    "lint": "pnpm run --recursive --no-sort --stream lint",
    "lint-fix": "pnpm run --recursive --no-sort --stream lint-fix",
    "prepare": "husky",
    "test": "pnpm run --recursive --no-sort --stream test",
    "typecheck": "pnpm run --recursive --no-sort --stream typecheck"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
